{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ImpactSampler Studio",
  "version": "0.1.0",
  "identifier": "com.impactsampler.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ImpactSampler Studio - Nektar Impact LX49+",
        "width": 1320,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "theme": "Dark",
        "backgroundColor": "#000000",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../soundfonts/*": "soundfonts/",
      "../samples/*": "samples/"
    }
  }
}
